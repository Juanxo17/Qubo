# =====================================================================
# Qubo Backend - Variables de entorno (copiar a .env y completar)
# =====================================================================

# MongoDB: URI de conexión (MongoDB Atlas o local).
# NOTA: el nombre de la base de datos se define en DB_NAME (no en la URI).
DATABASE_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos dentro del cluster (por defecto: Qubo)
DB_NAME=qubo_cloud

# JWT: firma y vigencia de los tokens de autenticación
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Puerto HTTP del servidor Node (default 8080)
PORT=8080

# NODE_ENV: development | production | test
NODE_ENV=development

# Identidad del nodo / réplica (para /health y /whoami)
NODE_ID=web1
INSTANCE_ID=web1-8080

# (Opcional) CORS - URL del frontend
FRONTEND_URL=http://localhost:5173
